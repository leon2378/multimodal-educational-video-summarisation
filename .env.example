# Optional for local development: every value below is already the built-in default
# (lecture_core/settings.py) and matches infra/compose.yaml. Copy to .env to change one.
# Deployed environments set all of these through their own secrets.

DATABASE_URL=postgresql+asyncpg://lecture:lecture@localhost:5432/lecture

S3_ENDPOINT_URL=http://localhost:8333
# Set only when clients reach storage on a different host from the API.
# S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=lecture-dev
S3_SECRET_ACCESS_KEY=lecture-dev-secret
S3_BUCKET=lectures

UPLOAD_URL_TTL_S=3600
MAX_UPLOAD_BYTES=5368709120

# Baselines and evals (no default). Get a key at https://aistudio.google.com/apikey.
# On the free tier, Google may use what you send to improve its products: public lectures only.
# GEMINI_API_KEY=
