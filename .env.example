# Optional for local development: every value below except GEMINI_API_KEY is already the
# built-in default and matches infra/compose.yaml. Copy to .env to change one. Deployed
# environments set all of these through their own secrets.

# Needed for the pipeline's LLM steps and the Gemini baseline. Get a key at
# https://aistudio.google.com/apikey. On the free tier, Google may use what you send to improve
# its products: public lectures only.
# GEMINI_API_KEY=

DATABASE_URL=postgresql+asyncpg://lecture:lecture@localhost:5432/lecture

S3_ENDPOINT_URL=http://localhost:8333
# Set only when clients reach storage on a different host from the API.
# S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=lecture-dev
S3_SECRET_ACCESS_KEY=lecture-dev-secret
S3_BUCKET=lectures

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

UPLOAD_URL_TTL_S=3600
MAX_UPLOAD_BYTES=5368709120

# Search: Qdrant, and the TEI servers for embeddings and reranking.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=segments
EMBEDDINGS_URL=http://localhost:8081
RERANKER_URL=http://localhost:8082
# dense, bm25, hybrid or rerank. Rerank ranks best but needs the reranker on a GPU to be quick;
# the Compose stack runs it there and sets rerank.
SEARCH_MODE=hybrid

# Pipeline models (lecture_llm/settings.py, lecture_pipeline/settings.py).
LLM_MODEL=google:gemini-3.5-flash-lite
WHISPER_MODEL_PATH=data/models/faster-whisper-large-v3-turbo
WHISPER_DEVICE=auto

# Workers (lecture_pipeline/temporal/worker.py).
WORKER_CPU_CONCURRENCY=4
WORKER_LLM_CONCURRENCY=4

# Observability. OpenTelemetry for the API and workers: http://otel-lgtm:4318 in Docker (start it
# with `make observability`), http://localhost:4318 for processes run on the host. Off when unset.
# OTEL_ENDPOINT=http://otel-lgtm:4318
# LLM calls also go to Langfuse when both keys are set (https://cloud.langfuse.com, or
# https://us.cloud.langfuse.com for the US region).
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
