# The demo's own secrets (ADR 0010). Copy to infra/cloud.env (git-ignored), fill in, and store
# with `make cloud-secrets`; the VM adds them to its stack's .env at boot. The rest of what
# infra/compose.cloud.yaml reads comes from the VM itself (SITE_ADDRESS, IMAGE_TAG,
# POSTGRES_PASSWORD) and from Terraform (the S3_* settings for the bucket).

GEMINI_API_KEY=

# Sign-in (ADR 0009): your Clerk instance's Frontend API URL, your Clerk user id, and the secret
# key. The publishable key goes in the repository's CLERK_PUBLISHABLE_KEY variable instead,
# since it's built into the web image.
AUTH_ISSUER=https://your-app.clerk.accounts.dev
ADMIN_USERS=["user_..."]
CLERK_SECRET_KEY=

# Modal (infra/modal/): a token for the worker's calls (`modal token new` makes one), the
# embedding server's URL that `make modal` prints, and a proxy auth token for it (Modal's
# dashboard, Settings > Proxy Auth Tokens).
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_EMBEDDINGS_URL=https://your-workspace--lecture-embeddings-serve.modal.run
MODAL_PROXY_KEY=
MODAL_PROXY_SECRET=

# Optional, for lectures from YouTube links, which YouTube often refuses from a cloud server
# (ADR 0011). A signed-in account's cookies.txt, base64 encoded (`base64 -w0 cookies.txt`), from
# a spare account since Google may flag one used this way, and/or a proxy for YouTube's traffic
# (a residential one gets refused least), http://user:password@host:port.
# YOUTUBE_COOKIES_B64=
# YOUTUBE_PROXY=
