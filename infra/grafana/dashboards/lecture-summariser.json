    {
      "type": "stat",
      "title": "LLM cost per lecture-hour",
      "description": "What the LLM calls behind each lecture's notes cost at paid-tier prices, cached ones included, divided by the hours of lecture. Latest run of each lecture of 10 minutes or more (fixed costs dominate short clips); runs from before cost tracking aren't counted.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sum(r.cost_usd) / sum(l.duration_s / 3600) AS \"USD per lecture-hour\" FROM ( SELECT DISTINCT ON (lecture_id) lecture_id, (llm_usage->>'cost_usd')::float AS cost_usd FROM pipeline_runs WHERE status = 'succeeded' AND llm_usage ? 'cost_usd' ORDER BY lecture_id, started_at DESC ) r JOIN lectures l ON l.id = r.lecture_id WHERE l.duration_s >= 600"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "–",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "–"
                }
              }
            }
          ],
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto"
      },
      "id": 3,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Processing minutes per lecture-hour",
      "description": "Wall-clock minutes a run took per hour of lecture, from the latest run of each lecture of 10 minutes or more that computed every stage, nothing from the cache.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sum(extract(epoch FROM r.took) / 60) / sum(l.duration_s / 3600) AS \"minutes per lecture-hour\" FROM ( SELECT DISTINCT ON (lecture_id) lecture_id, finished_at - started_at AS took FROM pipeline_runs WHERE status = 'succeeded' AND stages @> '[{\"stage\": \"index\"}]' AND NOT EXISTS ( SELECT 1 FROM jsonb_array_elements(stages) s WHERE (s->>'cached')::boolean) ORDER BY lecture_id, started_at DESC ) r JOIN lectures l ON l.id = r.lecture_id WHERE l.duration_s >= 600"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "–",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "–"
                }
              }
            }
          ],
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto"
      },
