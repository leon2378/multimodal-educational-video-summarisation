    {
      "type": "table",
      "title": "Recent pipeline runs",
      "description": "Minutes per lecture-hour only for runs in which nothing came from the cache. GPU seconds: speech recognition, the one GPU stage, when it ran.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT r.started_at AS \"started\", l.title AS \"lecture\", round((l.duration_s / 60)::numeric, 1) AS \"lecture min\", r.status, extract(epoch FROM r.finished_at - r.started_at) AS \"took\", (SELECT count(*) FROM jsonb_array_elements(r.stages) s WHERE (s->>'cached')::boolean) || ' of ' || jsonb_array_length(r.stages) AS \"cached stages\", (SELECT sum((s->>'seconds')::float) FROM jsonb_array_elements(r.stages) s WHERE s->>'stage' = 'asr' AND NOT (s->>'cached')::boolean) AS \"GPU s\", CASE WHEN NOT EXISTS (SELECT 1 FROM jsonb_array_elements(r.stages) s WHERE (s->>'cached')::boolean) THEN extract(epoch FROM r.finished_at - r.started_at) / 60 / nullif(l.duration_s / 3600, 0) END AS \"min per lecture-hour\", (r.llm_usage->>'cost_usd')::float AS \"LLM cost\", (r.llm_usage->>'input_tokens')::int + (r.llm_usage->>'output_tokens')::int AS \"tokens\", r.error FROM pipeline_runs r JOIN lectures l ON l.id = r.lecture_id ORDER BY r.started_at DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "–"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "took"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "GPU s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "min per lecture-hour"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "LLM cost"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 4
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
